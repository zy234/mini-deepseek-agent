# 本地运行配置；复制到项目 .env 后填写敏感值。
# DeepSeek 兼容 API 的访问密钥。
DS_KEY=
# MiniQMT Bridge 的 HTTP 地址，通常是本机 8023 端口。
MINIQMT_BRIDGE_URL=http://127.0.0.1:8023
# MiniQMT Bridge 的 API 密钥；未启用鉴权时留空。
MINIQMT_BRIDGE_API_KEY=
# 券商账户标识，只用于宿主侧查询和下单。
MINIQMT_ACCOUNT_ID=
# 交易模式：observe 只观察，execute 每次交易需确认，auto_execute 自动执行。
MINIQMT_AGENT_MODE=observe
# 轨迹、账本和交易意图状态的保存目录。
MINIQMT_AGENT_STATE_DIR=.sessions/account-manager
# 所有订单允许提交的单笔最大股数。
MINIQMT_MAX_ORDER_VOLUME=10000
# 单笔买入允许提交的最大股数。
MINIQMT_MAX_BUY_VOLUME=10000
# 单笔卖出允许提交的最大股数。
MINIQMT_MAX_SELL_VOLUME=10000
# 单笔买入允许使用的最大金额，单位为元。
MINIQMT_MAX_BUY_NOTIONAL=20000
# 一个交易日累计买入允许使用的最大金额，单位为元。
MINIQMT_MAX_DAILY_BUY_NOTIONAL=50000
# 每个盘中轮次最多提交的写操作笔数。
MINIQMT_MAX_ORDERS_PER_CYCLE=2
# 每笔买卖委托允许使用的最小金额，单位为元。
MINIQMT_MIN_ORDER_NOTIONAL=5000
# 买入完成后账户必须保留的最低现金比例。
MINIQMT_MIN_CASH_RATIO=0.10
# 自动交易允许使用的行情最大年龄，单位为秒。
MINIQMT_MAX_QUOTE_AGE_SECONDS=30
# 委托价相对最新价允许偏离的最大基点数，50bp 等于 0.50%。
MINIQMT_MAX_PRICE_DEVIATION_BPS=50
# 交易总开关：1/true 开启后禁止所有交易写操作，0/false 表示关闭。
MINIQMT_KILL_SWITCH=0
# 是否允许网页抓取在 HTTP 失败时启用浏览器降级，0 表示关闭。
MSWEA_WEB_FETCH_BROWSER=1
# 网页历史截断时间；留空表示不限制时间点。
MSWEA_WEB_AS_OF=
